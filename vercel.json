{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd app/frontend && npm install --legacy-peer-deps && EXPO_PUBLIC_BUILD_SHA=\"${VERCEL_GIT_COMMIT_SHA:-}\" npx expo export -p web",
  "outputDirectory": "app/frontend/dist",
  "installCommand": "echo 'handled in buildCommand'",
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "ci/*": false
    }
  }
}
